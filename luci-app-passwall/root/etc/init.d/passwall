#!/bin/sh /etc/rc.common
START=99
STOP=15
EXTRA_COMMANDS="recover update_core stop_for_update"
EXTRA_HELP="\trecover Recover an interrupted protected transition"
ROOT="${IPKG_INSTROOT:-}"
. "$ROOT/usr/share/passwall/utils.sh"
. "$ROOT/usr/share/passwall/switch_guard.sh"
. "$ROOT/usr/share/passwall/switch_lifecycle.sh"
APP_FILE=${APP_PATH}/app.sh
LOCK_FILE=${LOCK_PATH}/${CONFIG}.lock

set_lock() {
 mkdir -p "$LOCK_PATH" || return 1
 command exec 9>"$LOCK_FILE" || return 1
 flock -xn 9
}
set_lock_wait() {
 mkdir -p "$LOCK_PATH" || return 1
 command exec 9>"$LOCK_FILE" || return 1
 local i
 for i in $(seq 1 25); do
  flock -xn 9 && return 0
  switch_current || return 1
  sleep 1
 done
 return 1
}
unset_lock() { flock -u 9; exec 9>&-; }

wait_updates() {
 local status i
 for i in $(seq 1 15); do
  switch_current || return 1
  PASSWALL_UPDATE_LOCK="${LOCK_PATH}/${CONFIG}_sub_rule.lock" lua -e '
   local nixio = require "nixio"
   local file = nixio.open(os.getenv("PASSWALL_UPDATE_LOCK"), "a")
   if not file then os.exit(2) end
   os.exit(file:lock("tlock") and 0 or 1)
  '
  status=$?
  [ "$status" != 1 ] && return "$status"
  sleep 1
 done
 echolog "订阅/规则仍在更新，取消本次切换；保留现有代理。"
 return 1
}

run_request() {
 local action="$1" status
 set_lock_wait || { echolog "已有切换进行中，恢复监控将处理最新请求。"; return 1; }
 if ! switch_current; then unset_lock; return 0; fi
 switch_cancel_stages
 if ! wait_updates; then switch_failed; unset_lock; return 1; fi
 switch_run "$action"; status=$?
 unset_lock
 return "$status"
}

boot_func() {
 rm -f "${LOCK_PATH}/${CONFIG}_ready.lock"
 switch_request boot || return 1
 set_lock_wait || return 1
 switch_current || { unset_lock; return 0; }
 switch_supervisor || { unset_lock; return 1; }
 switch_phase boot
 switch_core_restore || { switch_failed; unset_lock; return 1; }
 switch_guard_begin || { switch_failed; unset_lock; return 1; }
 local delay=$(config_n_get @global_delay[0] start_delay 1)
 case "$delay" in ''|*[!0-9]*) delay=1 ;; esac
 [ "$delay" -le 300 ] || delay=300
 while [ "$delay" -gt 0 ]; do
  switch_current || { unset_lock; return 0; }
  sleep 1
  delay=$((delay - 1))
 done
 switch_run boot
 local status=$?
 [ "$status" != 0 ] || touch "${LOCK_PATH}/${CONFIG}_ready.lock"
 unset_lock
 return "$status"
}
boot() { boot_func >/dev/null 2>&1 & }

start() {
 local action=${2:-$1}
 [ "$action" != start ] || action=
 switch_request start || return 1
 run_request "$action"
}
restart() {
 local action=${2:-$1}
 [ "$action" != restart ] || action=
 switch_request restart || return 1
 run_request "$action"
}
stop() {
 switch_request stop || return 1
 switch_supervisor || true
 set_lock_wait || return 1
 switch_current || { unset_lock; return 0; }
 switch_cancel_stages
 switch_stop
 local status=$?
 unset_lock
 return "$status"
}

# Compatibility for callers that manage replacement themselves. The independent
# watcher resumes the current configuration if the caller disappears.
stop_for_update() {
 switch_request update || return 1
 set_lock_wait || return 1
 switch_current || { unset_lock; return 1; }
 switch_supervisor || { unset_lock; return 1; }
 switch_capture || { unset_lock; return 1; }
 switch_phase updating
 switch_write retry_at "$(( $(switch_now) + 20 ))"
 local status=1
 if switch_guard_begin; then
  rm -f "$SWITCH_DIR/running"
  switch_exec 20 "$APP_FILE" stop; status=$?
 fi
 unset_lock
 return "$status"
}

update_core() {
 local source="$1" target="$2" status=1 temporary
 [ -f "$source" ] && [ -f "$target" ] && [ -x "$target" ] || return 1
 case "$target" in /*) ;; *) return 1 ;; esac
 case "$target" in *'
'*) return 1 ;; esac
 switch_request update || return 1
 set_lock_wait || return 1
 switch_current || { unset_lock; return 1; }
 switch_cancel_stages
 switch_supervisor && wait_updates || { unset_lock; return 1; }
 switch_core_restore || { unset_lock; return 1; }
 umask 077
 mkdir -p "$SWITCH_SAVE" && chmod 700 "$SWITCH_SAVE" || { unset_lock; return 1; }
 # Copy to an adjacent temporary path before stopping any traffic. The final
 # rename is atomic, and a hard link keeps the original executable recoverable.
 temporary=$(mktemp "${target}.passwall-new.XXXXXX") || { unset_lock; return 1; }
 if ! switch_exec 30 cp "$source" "$temporary" || ! chmod 755 "$temporary" || ! switch_current; then
  rm -f "$temporary"; unset_lock; return 1
 fi
 printf '%s\n' "$target" > "$SWITCH_SAVE/core-update.tmp"
 if ! mv -f "$SWITCH_SAVE/core-update.tmp" "$SWITCH_SAVE/core-update" || ! ln "$target" "$target.passwall-previous"; then
  rm -f "$temporary"; unset_lock; return 1
 fi
 switch_capture || { rm -f "$temporary"; switch_core_restore; unset_lock; return 1; }
 switch_phase updating
 switch_write retry_at 0
 if switch_guard_begin && switch_exec 20 "$APP_FILE" stop && switch_current && mv -f "$temporary" "$target"; then
  switch_run; status=$?
 else
  rm -f "$temporary"
  switch_core_restore
  switch_current && switch_run
 fi
 unset_lock
 return "$status"
}

recover() {
 SWITCH_REQUEST=$(switch_read request)
 [ -n "$SWITCH_REQUEST" ] || return 0
 set_lock || return 0
 switch_current || { unset_lock; return 0; }
 switch_cancel_stages
 wait_updates || { switch_failed; unset_lock; return 1; }
 switch_recover
 local status=$?
 unset_lock
 return "$status"
}
reload() { restart; }
