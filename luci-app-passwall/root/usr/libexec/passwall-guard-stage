#!/bin/sh
# Register before executing any mutation. Recovery invalidates the generation
# before killing registered timeout process groups, including their children.
stage="$1"
request="$2"
limit="$3"
shift 3
directory=/tmp/passwall_switch
umask 077
mkdir -p "$directory/stages" || exit 1
started=$(sed 's/.*) //' "/proc/$$/stat" | awk '{print $20}')
printf '%s\n%s\n' "$$" "$started" > "$directory/.stage-$stage"
mv -f "$directory/.stage-$stage" "$directory/stages/$stage" || exit 1
[ "$(cat "$directory/stage")" = "$stage" ] && [ "$(cat "$directory/request")" = "$request" ] || exit 1
exec /usr/bin/timeout -k 2 "$limit" "$@"
