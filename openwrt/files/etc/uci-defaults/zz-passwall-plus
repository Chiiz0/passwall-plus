#!/bin/sh

uci -q set system.@system[0].hostname='PassWall-Plus'

# Replace only the automatically generated br-lan device and keep unrelated
# devices intact if this overlay is reused on another x86/64 installation.
for section in $(uci -q show network | sed -n "s/^network\.\([^.=]*\)\.name='br-lan'$/\1/p"); do
	uci -q delete "network.${section}"
done

uci -q batch <<'EOF'
set network.br_lan='device'
set network.br_lan.name='br-lan'
set network.br_lan.type='bridge'
add_list network.br_lan.ports='eth0'
set network.lan='interface'
set network.lan.device='br-lan'
set network.lan.proto='static'
set network.lan.ipaddr='10.0.0.1'
set network.lan.netmask='255.255.255.0'
delete network.lan.ip6assign
set network.wan='interface'
set network.wan.device='eth1'
set network.wan.proto='dhcp'
set network.wan.delegate='0'
delete network.wan6
delete network.globals.ula_prefix
commit network

set dhcp.lan='dhcp'
set dhcp.lan.interface='lan'
set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'
set dhcp.lan.ra='disabled'
set dhcp.lan.dhcpv6='disabled'
set dhcp.lan.ndp='disabled'
delete dhcp.lan.ra_flags
commit dhcp

delete firewall.passwall_plus_reject_ipv6
set firewall.passwall_plus_reject_ipv6='rule'
set firewall.passwall_plus_reject_ipv6.name='PassWall-Plus-Reject-IPv6-LAN'
set firewall.passwall_plus_reject_ipv6.src='lan'
set firewall.passwall_plus_reject_ipv6.family='ipv6'
set firewall.passwall_plus_reject_ipv6.proto='all'
set firewall.passwall_plus_reject_ipv6.target='REJECT'
set firewall.passwall_plus_reject_ipv6.enabled='1'
commit firewall
EOF

uci -q set passwall.@global[0].reject_ipv6='1'
uci -q delete passwall.@global[0].ipv6_reject_zones
uci -q add_list passwall.@global[0].ipv6_reject_zones='lan'
uci -q commit passwall

logger -t passwall-plus 'applied dedicated x86/64 LAN, WAN, and IPv6 policy'
exit 0
